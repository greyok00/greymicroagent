{
  "name": "@cortex/protocol",
  "version": "0.7.3.2",
  "description": "Transport-neutral CBOR protocol for remote cortex sessions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cortex",
    "protocol",
    "cbor",
    "binary",
    "framing"
  ],
  "author": "GreyOK00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyok00/cortex.git",
    "directory": "packages/protocol"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "shx": "0.4.0",
    "vitest": "4.1.9"
  }
}
