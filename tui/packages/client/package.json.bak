{
  "name": "@cortex/client",
  "version": "0.7.3.2",
  "description": "Transport-neutral client for remote cortex sessions over framed CBOR bytes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./unix": {
      "types": "./dist/unix.d.ts",
      "import": "./dist/unix.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "test": "vitest --run",
    "typecheck": "tsgo -p tsconfig.test.json",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "cortex",
    "client",
    "protocol",
    "cbor",
    "binary"
  ],
  "author": "GreyOK00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greyok00/cortex.git",
    "directory": "packages/client"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@cortex/protocol": "^0.7.3"
  },
  "devDependencies": {
    "shx": "0.4.0",
    "vitest": "4.1.9"
  }
}
