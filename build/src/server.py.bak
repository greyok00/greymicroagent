from __future__ import annotations

import re
import subprocess
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
STATE = ROOT / "state"
STATE.mkdir(exist_ok=True)

LLAMA_SERVER = "/home/grey/llama.cpp/build/bin/llama-server"
MODEL_PATH = "/home/grey/qwen3.8-27b/Qwen3.8-27B-UD-Q3_K_XL.gguf"
MMPROJ_PATH = "/home/grey/qwen3.8-27b/mmproj-Qwen3.8-27B-f16.gguf"
PORT = 11811
HOST = "127.0.0.1"
CTX = 12288
NGL = -1
TEMP = 0.6
TOP_P = 0.95
TOP_K = 20

_proc = None


def server_url() -> str:
    return "http://%s:%d" % (HOST, PORT)


def is_ready() -> bool:
    try:
        with urllib.request.urlopen(server_url() + "/health", timeout=2) as r:
            return r.status == 200
    except Exception:
        return False


def start_model(timeout: float = 300.0) -> dict:
    global _proc
    if is_ready():
        return {"ok": True, "already": True}
    cmd = [
        LLAMA_SERVER,
        "--model", MODEL_PATH,
        "--mmproj", MMPROJ_PATH,
        "--no-mmproj-offload",
        "--host", HOST,
        "--port", str(PORT),
        "--ctx-size", str(CTX),
        "--n-gpu-layers", str(NGL),
        "--temp", str(TEMP),
        "--top-p", str(TOP_P),
        "--top-k", str(TOP_K),
        "--threads", "8",
        "--metrics",
        "--jinja",
    ]
    log = open(STATE / "model-server.log", "ab")
    _proc = subprocess.Popen(cmd, stdout=log, stderr=log, close_fds=True)
    t0 = time.time()
    while time.time() - t0 < timeout:
        if is_ready():
            return {"ok": True, "pid": _proc.pid}
        if _proc.poll() is not None:
            return {"ok": False, "error": "server exited rc=%d" % _proc.returncode}
        time.sleep(0.5)
    return {"ok": False, "error": "server not ready in %.0fs" % timeout}


def stop_model() -> None:
    global _proc
    if _proc and _proc.poll() is None:
        _proc.terminate()
        try:
            _proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            _proc.kill()
    _proc = None


def tokens_per_second() -> float:
    try:
        with urllib.request.urlopen(server_url() + "/metrics", timeout=3) as r:
            text = r.read().decode()
    except Exception:
        return 0.0
    gen = re.search(r"llamacpp:tokens_predicted_total\s+([0-9.]+)", text)
    sec = re.search(r"llamacpp:tokens_predicted_seconds_total\s+([0-9.]+)", text)
    if gen and sec:
        try:
            return float(gen.group(1)) / float(sec.group(1))
        except Exception:
            return 0.0
    return 0.0
